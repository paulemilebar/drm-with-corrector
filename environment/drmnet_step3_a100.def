Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

%environment
    export LC_ALL=C
    export LANG=C.UTF-8
    export OPENCV_IO_ENABLE_OPENEXR=1
    export MITSUBA_VARIANT=cuda_ad_rgb
    export TORCH_CUDA_ARCH_LIST="8.0"
    export DRJIT_LIBLLVM_PATH=/usr/lib/llvm-11/lib/libLLVM-11.so.1
    export PYTHONPATH="/opt/taming-transformers:${PYTHONPATH}"
    export PIP_DEFAULT_TIMEOUT=1000
    export PIP_RETRIES=20

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_DEFAULT_TIMEOUT=1000
    export PIP_RETRIES=20
    export TORCH_CUDA_ARCH_LIST="8.0"

    PYTHON_VERSION=3.8

    apt-get update
    apt-get install -y \
        software-properties-common \
        curl \
        wget \
        ca-certificates \
        git \
        g++ \
        make \
        unzip \
        x11-apps \
        cmake \
        ninja-build \
        llvm-11 \
        llvm-11-dev \
        clang-format \
        gdb \
        zlib1g-dev \
        libopenexr-dev \
        libpng-dev \
        libjpeg-dev \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-distutils \
        python${PYTHON_VERSION}-tk

    curl -sS https://bootstrap.pypa.io/pip/3.8/get-pip.py | python${PYTHON_VERSION}

    ln -fs /usr/bin/python${PYTHON_VERSION} /usr/bin/python
    ln -fs /usr/bin/python${PYTHON_VERSION} /usr/bin/python3

    python${PYTHON_VERSION} -m pip install --upgrade --no-cache-dir --timeout 1000 --retries 20 \
        pip \
        setuptools \
        wheel

    python${PYTHON_VERSION} -m pip install --no-cache-dir --timeout 1000 --retries 20 \
        torch==2.0.1+cu118 \
        torchvision==0.15.2+cu118 \
        --index-url https://download.pytorch.org/whl/cu118

    export FORCE_CUDA=1
    export NATTEN_CUDA_ARCH="8.0"
    export MAX_JOBS=8
    python${PYTHON_VERSION} -m pip install --no-cache-dir --timeout 1000 --retries 20 \
        --no-build-isolation \
        --no-binary=natten \
        natten==0.17.1

    python${PYTHON_VERSION} -m pip install --ignore-installed --no-cache-dir --timeout 1000 --retries 20 \
        PyYAML==6.0.2

    python${PYTHON_VERSION} -m pip install --no-cache-dir --timeout 1000 --retries 20 \
        numpy==1.23.5 \
        scipy==1.10.1 \
        opencv-python-headless==4.9.0.80 \
        mitsuba==3.6.1 \
        drjit==1.0.3 \
        albumentations==1.3.1 \
        pudb \
        imageio \
        imageio-ffmpeg \
        scikit-image==0.21.0 \
        scikit-learn==1.3.2 \
        lpips \
        pytorch-lightning==1.9.0 \
        omegaconf==2.3.0 \
        streamlit==1.40.1 \
        torch-fidelity \
        einops \
        transformers==4.46.3 \
        matplotlib==3.7.5 \
        tqdm \
        Pillow==10.4.0 \
        tensorboard==2.14.0 \
        pytorch-fid

    cd /opt
    git clone https://github.com/CompVis/taming-transformers.git
    cd /opt/taming-transformers
    python${PYTHON_VERSION} -m pip install --no-cache-dir --timeout 1000 --retries 20 -e .

    python${PYTHON_VERSION} -m pip freeze > /opt/drmnet_pip_freeze.txt

    rm -rf /var/lib/apt/lists/*

%runscript
    echo "DRMNet / Agentic-DRM a100 container"
    echo "Container was started $(date)"
    exec bash
